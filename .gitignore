# Participant data never enters version control.
data/
*.csv
!config/**/*.csv
!tests/fixtures/**/*.csv

# Screenshots: approved references are committed, working output is not.
screenshots/current/
screenshots/diff/

# Environment
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Editor / OS
.DS_Store
.vscode/
.idea/

# Claude Code local overrides
.claude/settings.local.json
CLAUDE.local.md

# A commit message with a blank line in it cannot be passed to `git commit -m`: the PreToolUse
# hook refuses one shell command containing a newline. Writing it to a file and using -F is the
# way round, and the file is scratch.
tools/commit_message.txt
