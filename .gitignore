# Participant data never enters version control.
data/
*.csv
!config/**/*.csv
!tests/fixtures/**/*.csv

# Screenshots: approved references are committed, working output is not.
screenshots/current/
screenshots/diff/
screenshots/vas_layouts/
# Renders kept because a decision was made from them, and no tool can produce them again.
# See screenshots/archive/README.md; commit one deliberately if it must survive a clone.
screenshots/archive/

# Environment
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Editor / OS
.DS_Store
.vscode/
.idea/

# Machine-local build overrides: where conda lives on this machine, and nothing else.
# The committed Makefile defaults to plain `conda` so the lab PC is unaffected.
Makefile.local
# Setup notes for one particular machine (paths, missing tools, workarounds). Kept out of the
# repository because they describe that machine, not the software.
LOCAL_SETUP.md

# Claude Code local overrides
.claude/settings.local.json
# Per-agent working copies for parallel streams; each is a branch, not part of this tree.
.claude/worktrees/
CLAUDE.local.md

# A commit message with a blank line in it cannot be passed to `git commit -m`: the PreToolUse
# hook refuses one shell command containing a newline. Writing it to a file and using -F is the
# way round, and the file is scratch.
tools/commit_message.txt
